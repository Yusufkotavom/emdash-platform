---
import { Icon } from "astro-iconset/components";
import { sanitizeHref } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type FeaturesBlock = Extract<PageContentBlock, { _type: "marketing_features" }>;
type Props = BlockComponentProps<FeaturesBlock>;

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const { anchor_id, eyebrow, headline, subheadline } = raw;
const features = Array.isArray(raw.features) ? raw.features : [];
const columns = String(raw.columns ?? "3");
const panel = String(raw.panel ?? "none"); // none | sunken | ink
const hasPanel = panel === "sunken" || panel === "ink";

const iconMap: Record<string, string> = {
	zap: "ph:lightning",
	shield: "ph:shield-check",
	users: "ph:users-three",
	chart: "ph:chart-bar",
	code: "ph:code",
	globe: "ph:globe",
	heart: "ph:heart",
	star: "ph:star",
	check: "ph:check-circle",
	lock: "ph:lock",
	clock: "ph:clock",
	cloud: "ph:cloud",
	building: "ph:buildings",
	leaf: "ph:leaf",
	gauge: "ph:gauge",
	thermometer: "ph:thermometer-simple",
	plug: "ph:plug",
	bell: "ph:bell-simple",
	file: "ph:file-text",
	sun: "ph:sun",
	trend: "ph:trend-up",
};

const items = features.map((f: any) => {
	const linkLabel = f.link_label ?? f.linkLabel;
	const linkUrl = f.link_url ?? f.linkUrl;
	return {
		...f,
		iconName: iconMap[f.icon] ?? "ph:sparkle",
		link: linkLabel && linkUrl ? { label: linkLabel, url: sanitizeHref(linkUrl) } : undefined,
	};
});
---

<section id={anchor_id || undefined} class="band section features-section">
	<div class="frame">
		<div class:list={hasPanel ? ["sheet", panel === "ink" ? "sheet--night" : "sheet--sunken"] : []}>
			<div class:list={hasPanel ? "sheet-body" : []}>
				<header class="section-header">
					{eyebrow && <p class="eyebrow">{eyebrow}</p>}
					<h2 class="section-headline">
						{headline}
						{subheadline && " "}
						{subheadline && <span class="section-headline__muted">{subheadline}</span>}
					</h2>
				</header>
				<ul class="features" role="list" style={`--cols:${columns}`}>
					{items.map((feature: any) => (
						<li class="card feature">
							<span class="icon-tile" aria-hidden="true">
								<Icon name={feature.iconName} />
							</span>
							<h3 class="feature__title">{feature.title}</h3>
							{toParagraphs(feature.description ?? "").map((paragraph: string) => (
								<p class="feature__description">{paragraph}</p>
							))}
							{feature.link && (
								<a href={feature.link.url} class="text-link feature__link">
									{feature.link.label}
									<Icon name="ph:arrow-right" aria-hidden="true" class="arrow" />
								</a>
							)}
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.features {
		display: grid;
		grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
		gap: 16px;
		list-style: none;
	}

	.feature {
		display: flex;
		flex-direction: column;
		padding: 28px 28px 32px;
	}

	.feature__title {
		margin-block-start: 24px;
		font-size: 16px;
		line-height: 1.4;
		letter-spacing: -0.005em;
	}

	.feature__description {
		margin-block-start: 8px;
		font-size: 15px;
		line-height: 1.6;
		color: var(--color-muted);
		text-wrap: pretty;
	}

	.feature__link {
		margin-block-start: 18px;
	}

	/* Inside a dark panel the inner tiles turn translucent so they read as one
	   panel with quiet rows, not card-in-card. */
	.sheet--night .feature {
		background: var(--color-night-card);
		border-color: var(--color-night-border);
		box-shadow: none;
	}

	.sheet--night .feature__description {
		color: var(--color-on-night-muted);
	}

	.sheet--night .icon-tile {
		background: rgb(255 255 255 / 0.1);
		color: var(--color-on-night);
	}

	@media (max-width: 1024px) {
		.features {
			grid-template-columns: repeat(min(var(--cols, 3), 3), minmax(0, 1fr));
		}
	}

	@media (max-width: 960px) {
		.features {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.features {
			grid-template-columns: minmax(0, 1fr);
		}

		.feature {
			padding: 24px;
		}
	}
</style>
