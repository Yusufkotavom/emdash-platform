---
import { Icon } from "astro-iconset/components";
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type HeroBlock = Extract<PageContentBlock, { _type: "marketing_hero" }>;
type Props = BlockComponentProps<HeroBlock>;

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const { anchor_id, eyebrow, headline, subheadline, centered } = raw;
const image = raw.image ?? raw.imageUrl;
const image_caption = raw.image_caption ?? raw.imageCaption;

const eyebrowUrl = (raw.eyebrow_url ?? raw.eyebrowUrl) ? sanitizeHref(raw.eyebrow_url ?? raw.eyebrowUrl) : undefined;
const primaryCtaLabel = raw.primary_cta_label ?? raw.primaryCtaLabel;
const primaryCtaUrl = raw.primary_cta_url ?? raw.primaryCtaUrl;
const primaryCta =
	primaryCtaLabel && primaryCtaUrl
		? { label: primaryCtaLabel, url: sanitizeHref(primaryCtaUrl) }
		: undefined;
const secondaryCtaLabel = raw.secondary_cta_label ?? raw.secondaryCtaLabel;
const secondaryCtaUrl = raw.secondary_cta_url ?? raw.secondaryCtaUrl;
const secondaryCta =
	secondaryCtaLabel && secondaryCtaUrl
		? { label: secondaryCtaLabel, url: sanitizeHref(secondaryCtaUrl) }
		: undefined;
---

<section
	id={anchor_id || undefined}
	class:list={["hero", { "hero--centered": centered }]}
>
	<div class="frame">
		{
			eyebrow && eyebrowUrl && (
				<a href={eyebrowUrl} class="hero__announce rise">
					{eyebrow}
					<Icon name="ph:arrow-right" aria-hidden="true" class="arrow" />
				</a>
			)
		}
		{eyebrow && !eyebrowUrl && <p class="hero__announce rise">{eyebrow}</p>}
		<h1 class="hero__headline rise">{headline}</h1>
		{
			(subheadline || primaryCta || secondaryCta) && (
				<div class="hero__row rise">
					{subheadline && <p class="lead hero__lead">{subheadline}</p>}
					{(primaryCta || secondaryCta) && (
						<div class="actions">
							{primaryCta && (
								<a href={primaryCta.url} class="btn btn-primary btn-lg">
									{primaryCta.label}
									<Icon name="ph:arrow-right" aria-hidden="true" class="arrow" />
								</a>
							)}
							{secondaryCta && (
								<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
									{secondaryCta.label}
								</a>
							)}
						</div>
					)}
				</div>
			)
		}
	</div>
	{
		image && (
			<div class="frame hero__media-wrap">
				<figure class="media hero__media settle">
					<div class="media__img">
						<Image
							image={image}
							priority
							sizes="(min-width: 1264px) 1136px, 92vw"
						/>
					</div>
					{image_caption && (
						<figcaption class="media-chip">
							{image_caption}
						</figcaption>
					)}
				</figure>
			</div>
		)
	}
</section>

<style>
	.hero {
		padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(2rem, 1.5rem + 2vw, 3rem);
	}

	.hero__announce {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 34px;
		padding-block: 6px;
		padding-inline: 14px;
		border-radius: 17px;
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		font-size: 13.5px;
		line-height: 1.35;
		color: var(--color-text-secondary);
		transition: box-shadow 160ms var(--ease-out);
	}

	.hero__announce :global(.arrow) {
		flex: none;
		color: var(--color-muted);
	}

	a.hero__announce:hover {
		box-shadow: var(--shadow-card-hover);
	}

	.hero__headline {
		--rise-index: 1;
		max-width: 16ch;
		font-size: var(--font-size-hero, clamp(2.5rem, 2rem + 3.5vw, 4.5rem));
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	.hero__announce + .hero__headline {
		margin-block-start: 24px;
	}

	.hero__row {
		--rise-index: 2;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 32px;
		margin-block-start: 32px;
	}

	.hero__lead {
		max-width: 50ch;
		font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
	}

	.hero__media-wrap {
		margin-block-start: clamp(36px, 4.5vw, 64px);
	}

	.hero__media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 21 / 9;
		border-radius: var(--radius-xl);
		background: var(--color-fill);
	}

	.hero__media::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		outline: 1px solid var(--color-media-outline);
		pointer-events: none;
	}

	.hero--centered .frame {
		text-align: center;
	}

	.hero--centered .hero__headline {
		max-width: 20ch;
		margin-inline: auto;
		font-size: var(--font-size-hero, clamp(2.75rem, 2.2rem + 4vw, 5rem));
	}

	.hero--centered .hero__row {
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
	}

	.hero--centered .actions {
		justify-content: center;
	}

	@media (max-width: 960px) {
		.hero__row {
			grid-template-columns: minmax(0, 1fr);
		}

		.hero__media {
			aspect-ratio: 16 / 10;
		}
	}

	@media (max-width: 640px) {
		.hero__media {
			aspect-ratio: 4 / 3;
		}
	}
</style>
