---
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type CTABlock = Extract<PageContentBlock, { _type: "marketing_cta" }>;
type Props = BlockComponentProps<CTABlock>;

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const { anchor_id, headline } = raw;
const image = raw.image ?? raw.imageUrl;

const paragraphs = toParagraphs(raw.body ?? "");
const primaryCtaLabel = raw.primary_cta_label ?? raw.primaryCtaLabel;
const primaryCtaUrl = raw.primary_cta_url ?? raw.primaryCtaUrl;
const primaryCta =
	primaryCtaLabel && primaryCtaUrl
		? { label: primaryCtaLabel, url: sanitizeHref(primaryCtaUrl) }
		: undefined;
const secondaryCtaLabel = raw.secondary_cta_label ?? raw.secondaryCtaLabel;
const secondaryCtaUrl = raw.secondary_cta_url ?? raw.secondaryCtaUrl;
const secondaryCta =
	secondaryCtaLabel && secondaryCtaUrl
		? { label: secondaryCtaLabel, url: sanitizeHref(secondaryCtaUrl) }
		: undefined;
---

<section class="band section cta-section" id={anchor_id || undefined}>
	<div class="frame">
		<div
			class:list={[
				"cta",
				"sheet",
				image ? ["cta--photo", "settle"] : ["cta--themed", "sheet--sunken"],
			]}
		>
			{image && (
				<div class="cta__bg">
					<Image image={image} alt="" sizes="(min-width: 1264px) 1136px, 92vw" />
				</div>
			)}
			<div class="cta__content">
				<h2 class="display cta__headline">{headline}</h2>
				{paragraphs.map((paragraph) => <p class="cta__body">{paragraph}</p>)}
				{(primaryCta || secondaryCta) && (
					<div class="actions cta__actions">
						{primaryCta && (
							<a href={primaryCta.url} class="btn btn-primary btn-lg">
								{primaryCta.label}
							</a>
						)}
						{secondaryCta && (
							<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
								{secondaryCta.label}
							</a>
						)}
					</div>
				)}
			</div>
		</div>
	</div>
</section>

<style>
	.cta {
		display: grid;
		align-items: center;
		min-height: clamp(480px, 42vw, 640px);
	}

	.cta--photo {
		color: #fff;
		background-color: var(--color-night);
	}

	.cta--photo::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			to right,
			rgb(15 14 13 / 0.86),
			rgb(15 14 13 / 0.6) 40%,
			rgb(15 14 13 / 0.08) 80%
		);
	}

	.cta--photo:dir(rtl)::before {
		background: linear-gradient(
			to left,
			rgb(15 14 13 / 0.86),
			rgb(15 14 13 / 0.6) 40%,
			rgb(15 14 13 / 0.08) 80%
		);
	}

	.cta__bg {
		position: absolute;
		inset: 0;
		z-index: -2;
	}

	.cta__bg :global(img) {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		object-fit: cover;
	}

	.cta__content {
		padding-block: 72px;
	}

	.cta__headline {
		max-width: 560px;
		font-size: clamp(44px, 5.2vw, 76px);
		line-height: 0.98;
	}

	.cta__body {
		max-width: 42ch;
		margin-block-start: 20px;
		font-size: 18px;
		color: var(--color-text-secondary);
	}

	.cta--photo .cta__body,
	.cta--night .cta__body {
		color: var(--color-on-night-muted);
	}

	.cta--photo .cta__body {
		color: rgb(255 255 255 / 0.74);
	}

	.cta__actions {
		max-width: 560px;
		margin-block-start: 36px;
	}

	:is(.cta--themed, .cta--night) {
		min-height: 0;
		text-align: center;
	}

	:is(.cta--themed, .cta--night) .cta__content {
		padding-block: clamp(72px, 8vw, 112px);
	}

	:is(.cta--themed, .cta--night) .cta__headline,
	:is(.cta--themed, .cta--night) .cta__body {
		margin-inline: auto;
	}

	:is(.cta--themed, .cta--night) .cta__headline {
		max-width: 16ch;
	}

	:is(.cta--themed, .cta--night) .cta__actions {
		justify-content: center;
		margin-inline: auto;
	}

	.cta :focus-visible {
		outline-color: var(--color-on-night);
	}

	@media (max-width: 960px) {
		.cta--photo {
			align-items: end;
			min-height: 560px;
		}

		:is(.cta--photo, .cta--photo:dir(rtl))::before {
			background: linear-gradient(
				to top,
				rgb(15 14 13 / 0.9),
				rgb(15 14 13 / 0.6) 50%,
				rgb(15 14 13 / 0.1)
			);
		}

		.cta__content {
			padding-block: 40px;
		}
	}
</style>
