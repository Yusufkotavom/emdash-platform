---
import { Icon } from "astro-iconset/components";
import { getEmDashCollection, getTermsForEntries } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import PostCard from "../PostCard.astro";
import { buildOgImageUrl } from "../../lib/og/url";

type FeedBlock = Extract<PageContentBlock, { _type: "marketing_feed" }>;
type Props = BlockComponentProps<FeedBlock>;

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const { anchor_id, eyebrow, headline, subheadline } = raw;

const collection = String(raw.source ?? raw.collection ?? "posts").trim() || "posts";
const mode = String(raw.mode ?? "latest"); // latest | tag | category | random | manual
const layout = String(raw.layout ?? "grid"); // grid | list | slide
const limit = Math.max(1, Math.min(24, Number(raw.limit ?? 6) || 6));
const term = String(raw.term ?? "").trim();
const manualIds = String(raw.manual_ids ?? raw.manualIds ?? "")
	.split(/[\n,]+/)
	.map((id) => id.trim())
	.filter(Boolean);

const ctaLabel = raw.cta_label ?? raw.ctaLabel;
const ctaUrl = raw.cta_url ?? raw.ctaUrl;

const isPosts = collection === "posts";
const origin = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");

const where =
	mode === "tag" ? { tag: term } : mode === "category" ? { category: term } : undefined;

// Random pulls a wider window then shuffles in JS; manual fetches a broad set
// and re-orders by the supplied id list. Everything else is a normal ordered read.
const fetchLimit =
	mode === "manual" ? 100 : mode === "random" ? Math.max(limit * 4, 24) : limit;

let entries: any[] = [];
try {
	const res = await getEmDashCollection(collection as any, {
		where,
		orderBy: isPosts ? { published_at: "desc" } : undefined,
		limit: fetchLimit,
	});
	entries = res.entries ?? [];
	if (Astro.cache?.enabled && res.cacheHint) Astro.cache.set(res.cacheHint);
} catch {
	entries = [];
}

if (mode === "random") {
	for (let i = entries.length - 1; i > 0; i--) {
		const j = Math.floor(Math.random() * (i + 1));
		[entries[i], entries[j]] = [entries[j], entries[i]];
	}
} else if (mode === "manual") {
	const byId = new Map(entries.map((entry) => [String(entry.id), entry]));
	entries = manualIds.map((id) => byId.get(id)).filter(Boolean);
}

entries = entries.slice(0, limit);

// Tags are only meaningful for posts, and only when we actually have entries.
let tagsByEntry = new Map<string, Array<{ slug: string; label: string }>>();
if (isPosts && entries.length > 0) {
	try {
		tagsByEntry = await getTermsForEntries(
			"posts",
			entries.map((entry) => entry.data.id),
			"tag",
		);
	} catch {
		tagsByEntry = new Map();
	}
}

const hrefFor = (entry: any) =>
	isPosts ? `/posts/${entry.id}` : collection === "pages" ? `/${entry.id}` : `/${collection}/${entry.id}`;
const imgFor = (entry: any) =>
	entry.data?.featured_image ?? buildOgImageUrl(origin, collection, entry.id);
---

<section id={anchor_id || undefined} class:list={["band", "section", "feed-section", `feed-section--${layout}`]}>
	<div class="frame">
		{
			(eyebrow || headline || subheadline || (ctaLabel && ctaUrl)) && (
				<div class="feed__head">
					<div>
						{eyebrow && <p class="eyebrow">{eyebrow}</p>}
						{headline && <h2 class="section-headline feed__headline">{headline}</h2>}
						{subheadline && <p class="feed__subheadline">{subheadline}</p>}
					</div>
					{ctaLabel && ctaUrl && (
						<a href={ctaUrl} class="arrow-link feed__all">
							{ctaLabel}
							<Icon name="ph:arrow-right" aria-hidden="true" />
						</a>
					)}
				</div>
			)
		}

		{
			entries.length === 0 ? (
				<p class="feed__empty">No entries to show.</p>
			) : layout === "list" ? (
				<ol class="feed__list" role="list">
					{entries.map((entry) => (
						<li>
							{isPosts ? (
								<PostCard
									post={entry}
									tags={tagsByEntry.get(entry.data.id) ?? []}
									variant="row"
									site={Astro.site ?? null}
								/>
							) : (
								<a href={hrefFor(entry)} class="feed-row">
									<span class="feed-row__media">
										<img src={imgFor(entry)} alt="" width="240" height="126" loading="lazy" />
									</span>
									<span class="feed-row__title">{entry.data.title}</span>
								</a>
							)}
						</li>
					))}
				</ol>
			) : layout === "slide" ? (
				<div data-slider>
					<ul class="feed__track slider__track" data-track role="list">
						{entries.map((entry) => (
							<li class="feed__slide">
								{isPosts ? (
									<PostCard
										post={entry}
										tags={tagsByEntry.get(entry.data.id) ?? []}
										variant="card"
										site={Astro.site ?? null}
									/>
								) : (
									<a href={hrefFor(entry)} class="card feed-card">
										<span class="feed-card__media">
											<img src={imgFor(entry)} alt="" width="1200" height="630" loading="lazy" />
										</span>
										<span class="feed-card__title">{entry.data.title}</span>
									</a>
								)}
							</li>
						))}
					</ul>
					<div class="slider__dots feed__dots" data-dots>
						{entries.map(() => (
							<button type="button" class="slider__dot" aria-label="Go to slide" />
						))}
					</div>
				</div>
			) : (
				<div class="post-grid">
					{entries.map((entry) =>
						isPosts ? (
							<PostCard
								post={entry}
								tags={tagsByEntry.get(entry.data.id) ?? []}
								variant="card"
								site={Astro.site ?? null}
							/>
						) : (
							<a href={hrefFor(entry)} class="card feed-card">
								<span class="feed-card__media">
									<img src={imgFor(entry)} alt="" width="1200" height="630" loading="lazy" />
								</span>
								<span class="feed-card__title">{entry.data.title}</span>
							</a>
						),
					)}
				</div>
			)
		}
	</div>
</section>

<script>
	import "../../scripts/slider";
</script>

<style>
	.feed__head {
		display: flex;
		align-items: flex-end;
		align-items: last baseline;
		justify-content: space-between;
		gap: 24px;
		margin-block-end: clamp(24px, 3vw, 40px);
	}

	.feed__headline {
		max-width: 40ch;
	}

	.feed__subheadline {
		max-width: 60ch;
		margin-block-start: 12px;
		font-size: 17px;
		line-height: 1.55;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.feed__all {
		flex: none;
	}

	.feed__empty {
		padding: 48px 0;
		color: var(--color-muted);
	}

	.feed__list {
		list-style: none;
	}

	.feed__list > li + li {
		border-block-start: 1px solid var(--color-border);
	}

	/* Slide layout reuses the slider track styling but keeps its own sizing. */
	.feed__track {
		display: flex;
		gap: 16px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
	}

	.feed__track::-webkit-scrollbar {
		display: none;
	}

	.feed__slide {
		flex: none;
		width: clamp(260px, 32%, 380px);
		scroll-snap-align: start;
	}

	.feed__dots {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-block-start: 20px;
	}

	.feed-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		padding: var(--card-padding);
		height: 100%;
	}

	.feed-card__media {
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		border-radius: var(--radius-lg);
		background: var(--color-fill);
	}

	.feed-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.feed-card__title {
		margin-block-start: var(--spacing-4);
		font-size: var(--font-size-lg);
		font-weight: 600;
		line-height: 1.3;
	}

	.feed-row {
		display: flex;
		align-items: center;
		gap: 20px;
		padding-block: 20px;
	}

	.feed-row__media {
		flex: none;
		width: 160px;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		border-radius: var(--radius-lg);
		background: var(--color-fill);
	}

	.feed-row__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.feed-row__title {
		font-size: var(--font-size-lg);
		font-weight: 600;
		line-height: 1.3;
	}

	@media (max-width: 640px) {
		.feed__slide {
			width: 82%;
		}

		.feed-row__media {
			width: 110px;
		}
	}
</style>
