---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type StatsBlock = Extract<PageContentBlock, { _type: "marketing_stats" }>;
type Props = BlockComponentProps<StatsBlock>;

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const { anchor_id, headline, subheadline } = raw;
const stats = Array.isArray(raw.stats) ? raw.stats : [];
const panel = String(raw.panel ?? "none"); // none | sunken | ink
const hasPanel = panel === "sunken" || panel === "ink";
---

<section id={anchor_id || undefined} class="band section stats-section">
	<div class="frame">
		<div class:list={hasPanel ? ["sheet", panel === "ink" ? "sheet--night" : "sheet--sunken"] : []}>
			<div class:list={hasPanel ? "sheet-body" : []}>
				{
					(headline || subheadline) && (
						<h2 class="section-headline stats__headline">
							{headline}
							{headline && subheadline && " "}
							{subheadline && <span class="section-headline__muted">{subheadline}</span>}
						</h2>
					)
				}
				<dl class="stats__list">
					{stats.map((stat: any) => (
						<div class="stats__item">
							<dt class="stats__label">{stat.label}</dt>
							<dd class="stats__body">
								<span class="stats__value">{stat.value}</span>
								{toParagraphs(stat.description ?? "").map((p: string) => (
									<span class="stats__note">{p}</span>
								))}
							</dd>
						</div>
					))}
				</dl>
			</div>
		</div>
	</div>
</section>

<style>
	.stats__headline {
		max-width: 30ch;
		margin-block-end: clamp(32px, 4vw, 56px);
	}

	.stats__list {
		--stats-column-gap: 32px;
		display: grid;
		grid-template-columns: repeat(
			auto-fit,
			minmax(min(100%, max(180px, (100% - 3 * var(--stats-column-gap)) / 4)), 1fr)
		);
		gap: 36px var(--stats-column-gap);
	}

	.stats__item {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.stats__label {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.stats__body {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin: 0;
	}

	.stats__value {
		font-family: var(--font-heading);
		font-size: clamp(36px, 4vw, 56px);
		font-weight: var(--font-weight-display);
		font-variant-numeric: tabular-nums;
		line-height: 1;
		letter-spacing: -0.02em;
		overflow-wrap: anywhere;
	}

	.stats__note {
		max-width: 26ch;
		font-size: 14.5px;
		line-height: 1.5;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.sheet--night .stats__label,
	.sheet--night .stats__note {
		color: var(--color-on-night-muted);
	}

	@media (max-width: 960px) {
		.stats__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
