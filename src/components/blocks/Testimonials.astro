---
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type TestimonialsBlock = Extract<PageContentBlock, { _type: "marketing_testimonials" }>;
type Props = BlockComponentProps<TestimonialsBlock>;

const WHITESPACE = /\s+/;

function getInitials(name: string) {
	const letters = name
		.trim()
		.split(WHITESPACE)
		.map((word) => [...word][0] ?? "");
	const ends = letters.length > 1 ? [letters[0], letters.at(-1)] : letters;
	return ends.join("").toUpperCase();
}

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const { anchor_id, headline } = raw;
const testimonialsList = Array.isArray(raw.testimonials) ? raw.testimonials : [];
const [featured, ...others] = testimonialsList.map((testimonial: any) => ({
	...testimonial,
	initials: getInitials(testimonial?.author || ""),
	attribution: [testimonial?.role, testimonial?.company].filter(Boolean).join(", "),
	// Avatar can be a media object or a plain URL string.
	avatarUrl: testimonial?.avatar ?? testimonial?.image_url ?? testimonial?.imageUrl,
}));
---

<section id={anchor_id || undefined} class="band section testimonials-section">
	<div class="frame">
	{headline && <h2 class="eyebrow testimonials__label">{headline}</h2>}
	{
		featured && (
			<figure class="testimonials__featured">
				<span class="testimonials__mark" aria-hidden="true">“</span>
				<blockquote class="display testimonials__featured-quote">
					{toParagraphs(featured.quote ?? "").map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</blockquote>
				<figcaption class="testimonials__who">
					{typeof featured.avatarUrl === "object" && featured.avatarUrl ? (
						<Image image={featured.avatarUrl} alt="" width={44} height={44} class="testimonials__avatar" />
					) : featured.avatarUrl ? (
						<img src={featured.avatarUrl} alt="" width={44} height={44} class="testimonials__avatar" />
					) : (
						<span class="avatar" aria-hidden="true">
							{featured.initials}
						</span>
					)}
					<span>
						{featured.author}
						{featured.attribution && " "}
						{featured.attribution && (
							<span class="testimonials__role">{featured.attribution}</span>
						)}
					</span>
				</figcaption>
			</figure>
		)
	}
	{
		others.length > 0 && (
			<div class="testimonials__grid">
				{others.map((testimonial) => (
					<figure class="card testimonials__card">
						<blockquote class="testimonials__quote">
							{toParagraphs(testimonial.quote ?? "").map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</blockquote>
						<figcaption class="testimonials__who">
							{typeof testimonial.avatarUrl === "object" && testimonial.avatarUrl ? (
								<Image image={testimonial.avatarUrl} alt="" width={44} height={44} class="testimonials__avatar" />
							) : testimonial.avatarUrl ? (
								<img src={testimonial.avatarUrl} alt="" width={44} height={44} class="testimonials__avatar" />
							) : (
								<span class="avatar" aria-hidden="true">
									{testimonial.initials}
								</span>
							)}
							<span>
								{testimonial.author}
								{testimonial.attribution && " "}
								{testimonial.attribution && (
									<span class="testimonials__role">
										{testimonial.attribution}
									</span>
								)}
							</span>
						</figcaption>
					</figure>
				))}
			</div>
		)
	}
	</div>
</section>

<style>
	.testimonials__label {
		display: flex;
		justify-content: center;
		margin-block-end: 24px;
		line-height: var(--leading-normal);
		letter-spacing: normal;
	}

	.testimonials__featured {
		max-width: 960px;
		margin-inline: auto;
		text-align: center;
	}

	.testimonials__mark {
		display: block;
		height: 0.5em;
		font-family: var(--font-heading);
		font-size: 120px;
		line-height: 1;
		color: var(--color-accent);
	}

	.testimonials__featured-quote {
		font-size: clamp(30px, 3.5vw, 48px);
		line-height: 1.16;
		letter-spacing: -0.012em;
	}

	.testimonials__who {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		margin-block-start: 32px;
		font-size: 15px;
		font-weight: 500;
		text-align: start;
	}

	.testimonials__who :global(.testimonials__avatar) {
		flex: none;
		width: 44px;
		max-width: none;
		height: 44px;
		border-radius: 50%;
		object-fit: cover;
	}

	.testimonials__role {
		display: block;
		font-size: 14px;
		font-weight: 400;
		color: var(--color-muted);
	}

	.testimonials__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
		gap: 16px;
		margin-block-start: clamp(56px, 7vw, 96px);
	}

	.testimonials__card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 32px;
	}

	.testimonials__card .testimonials__who {
		margin-block-start: 28px;
	}

	.testimonials__quote {
		font-size: 17px;
		line-height: 1.6;
		text-wrap: pretty;
		quotes: "\201C" "\201D";
	}

	.testimonials__quote p:first-child::before {
		content: open-quote;
	}

	.testimonials__quote p:last-child::after {
		content: close-quote;
	}

	:is(.testimonials__featured-quote, .testimonials__quote) p + p {
		margin-block-start: 0.6em;
	}
</style>
