---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";

// Newest products first. Sort in the database (created_at) rather than in JS.
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: products,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("products", {
	orderBy: { created_at: "desc" },
	limit: 24,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Produk" description="Katalog produk Kotacom.">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Katalog</p>
			<h1 class="intro__title">Produk</h1>
			<p class="intro__lead">Semua produk kami.</p>
		</div>
	</header>

	<section class="band section archive-band">
		<div class="frame">
			{
				products.length === 0 ? (
					<div class="empty-state">
						<h2 class="empty-state__title">
							{cursor ? "Tidak ada lagi" : "Belum ada produk"}
						</h2>
						<p class="empty-state__text">
							{cursor
								? "Anda sudah mencapai akhir katalog."
								: "Produk yang dipublikasikan akan tampil di sini."}
						</p>
						{cursor && (
							<div class="empty-state__actions">
								<a href="/products" class="btn btn--ghost">
									Halaman pertama
								</a>
							</div>
						)}
					</div>
				) : (
					<>
						<div class="post-grid">
							{products.map((product) => (
								<PostCard
									post={product as any}
									collection="products"
									variant="card"
									headingLevel={2}
								/>
							))}
						</div>
						<Pagination basePath="/products" cursor={cursor} nextCursor={nextCursor} />
					</>
				)
			}
		</div>
	</section>
</Base>

<style>
	.archive-band {
		padding-block-start: 0;
	}
</style>
