---
import {
	getEmDashCollection,
	getEmDashEntry,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PageView from "../components/PageView.astro";
import PostCard from "../components/PostCard.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [
	homeResult,
	postsResult,
	settings,
] = await Promise.all([
	getEmDashEntry("pages", "home"),
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 6,
	}),
	getSiteSettings(),
]);

const homePage = homeResult.entry;
const posts = postsResult.entries;

if (Astro.cache?.enabled) {
	if (homeResult.cacheHint) Astro.cache.set(homeResult.cacheHint);
	if (postsResult.cacheHint) Astro.cache.set(postsResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

// Batched query for post tags
const postIds = posts.map((p) => p.data.id);
const tagsByEntry = await getTermsForEntries("posts", postIds, "tag");
const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));

const hasHomePage = !!homePage && Array.isArray(homePage.data.content) && homePage.data.content.length > 0;

// Blog fallback logic if no home page
const featuredPost = posts.find((p) => p.data.featured_image);
const featuredIndex = featuredPost ? posts.indexOf(featuredPost) : -1;
const gridPostsWithTags = postsWithTags.filter((_, i) => i !== featuredIndex);
const featuredTags = featuredPost ? (tagsByEntry.get(featuredPost.data.id) ?? []) : [];
---

<Base
	title={siteTitle}
	description={siteTagline}
	content={hasHomePage ? { collection: "pages", id: homePage.data.id, slug: "home" } : undefined}
>
	{
		hasHomePage ? (
			<>
				<PageView page={homePage as any} heading={siteTitle} />

				{postsWithTags.length > 0 && (
					<section class="band section home-posts-band" aria-labelledby="latest-posts">
						<div class="frame">
							<div class="section-head">
								<div>
									<p class="eyebrow">From the Blog</p>
									<h2 id="latest-posts" class="section-head__title">
										Latest thoughts & updates
									</h2>
								</div>
								<a href="/posts" class="arrow-link">
									View all posts
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.75"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M5 12h14" />
										<path d="m12 5 7 7-7 7" />
									</svg>
								</a>
							</div>
							<div class="post-grid">
								{postsWithTags.slice(0, 3).map(({ post, tags }) => (
									<PostCard
										post={post}
										tags={tags}
										variant="card"
										headingLevel={3}
									/>
								))}
							</div>
						</div>
					</section>
				)}
			</>
		) : (
			<>
				<header class="band intro">
					<div class="frame home-intro">
						<div>
							<p class="eyebrow">Blog</p>
							<h1 class="intro__title">{siteTitle}</h1>
							{siteTagline && <p class="intro__subtitle">{siteTagline}</p>}
						</div>
						<a
							href="/rss.xml"
							type="application/rss+xml"
							class="btn btn--ghost btn--sm home-intro__rss"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M4 11a9 9 0 0 1 9 9"></path>
								<path d="M4 4a16 16 0 0 1 16 16"></path>
								<circle cx="5" cy="19" r="1"></circle>
							</svg>
							RSS feed
						</a>
					</div>
				</header>

				{featuredPost && (
					<section class="band section">
						<div class="frame">
							<PostCard
								post={featuredPost}
								tags={featuredTags}
								variant="feature"
								headingLevel={2}
								priority
							/>
						</div>
					</section>
				)}

				{gridPostsWithTags.length > 0 && (
					<section class="band section" aria-labelledby="fallback-latest-posts">
						<div class="frame">
							<div class="section-head">
								<h2 id="fallback-latest-posts" class="section-head__title">
									Latest posts
								</h2>
								<a href="/posts" class="arrow-link">
									View all<span class="sr-only"> posts</span>
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.75"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M5 12h14" />
										<path d="m12 5 7 7-7 7" />
									</svg>
								</a>
							</div>
							<div class="post-grid">
								{gridPostsWithTags.map(({ post, tags }) => (
									<PostCard
										post={post}
										tags={tags}
										variant="card"
										headingLevel={3}
									/>
								))}
							</div>
						</div>
					</section>
				)}
			</>
		)
	}
</Base>

<style>
	.home-intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: var(--spacing-6) var(--spacing-8);
	}

	.home-intro__rss {
		margin-block-end: var(--spacing-2);
	}

	.home-posts-band {
		padding-block: clamp(3rem, 2rem + 3vw, 5rem);
	}

	@media (max-width: 720px) {
		.home-intro {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-intro__rss {
			justify-self: start;
			margin-block-end: 0;
		}
	}
</style>
